# Copy to .env for local development. Keep real secrets out of Git.
PROJECT_NAME=Savo SiteScout
ENVIRONMENT=local

POSTGRES_USER=sitescout
POSTGRES_PASSWORD=sitescout_dev_password
POSTGRES_DB=sitescout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sitescout:sitescout_dev_password@postgres:5432/sitescout

REDIS_URL=redis://redis:6379/0
QUEUE_NAME=sitescout-jobs
EXTERNAL_CACHE_TTL_SECONDS=3600
STALE_CACHE_TTL_SECONDS=604800

# Optional live Savomart store service. Keep the actual URL/token only in .env.
STORE_SERVICE_URL=
STORE_SERVICE_TOKEN=

# Set true only for local debugging without a separate worker.
RQ_SYNC=false

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_BASE_URL=http://localhost:8000
