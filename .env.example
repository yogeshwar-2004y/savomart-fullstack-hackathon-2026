# Copy to .env for local development. Keep real secrets out of Git.
PROJECT_NAME=Savo SiteScout
ENVIRONMENT=local

POSTGRES_USER=sitescout
POSTGRES_PASSWORD=sitescout_dev_password
POSTGRES_DB=sitescout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sitescout:sitescout_dev_password@postgres:5432/sitescout

REDIS_URL=redis://redis:6379/0
QUEUE_NAME=sitescout-jobs
EXTERNAL_CACHE_TTL_SECONDS=3600
STALE_CACHE_TTL_SECONDS=604800
LOCATION_CACHE_TTL_SECONDS=86400

# Optional official Department of Posts OGD GeoJSON/GeoJSONL file inside the API/worker container.
# Download it from the catalog linked in README; do not commit large source datasets.
OGD_PINCODE_BOUNDARIES_PATH=
# Optional non-official Chennai coverage fallback; leave blank to disable.
CHENNAI_PINCODE_FEATURE_URL=https://services7.arcgis.com/8phUg7DrlXpKgLyA/ArcGIS/rest/services/Chennai_MarketVisualization_WFL1/FeatureServer/11

# Optional live Savomart store service. Keep the actual URL/token only in .env.
STORE_SERVICE_URL=
STORE_SERVICE_TOKEN=

# Set true only for local debugging without a separate worker.
RQ_SYNC=false

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_BASE_URL=http://localhost:8000
